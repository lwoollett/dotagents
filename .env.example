# Template for required environment variables. Nothing auto-loads this file —
# pi expands ${ENV_VAR} references in config/pi/mcp.json from the process
# environment, so export these in your shell profile. Copy to `.env`
# (gitignored) if you want a local scratchpad:  cp .env.example .env

# Azure DevOps Personal Access Token — used by the "ado" MCP server
# Needed for repo, work-item, and pull-request access.
PERSONAL_ACCESS_TOKEN=

# Z.ai (Zhipu) API key — used by zai-mcp-server, web-reader, web-search-prime, and zread
# Used as the Authorization: Bearer token for those tools.
Z_AI_API_KEY=

# NVIDIA API key — used by the nvidia-image-gen skill (scripts/generate.py)
# Must start with 'nvapi-'. Get one at https://build.nvidia.com
NVIDIA_API_KEY=

# Optional: enable proxy support for the "ado" MCP server (set to 1 to use environment proxy vars).
NODE_USE_ENV_PROXY=1
