# Template for required environment variables. Copy to `.env` and fill in real values.
#   cp .env.example .env
# The `.env` file is gitignored. OMP reads the same variables from `config/omp/.env` —
# keep that file in sync if you want OMP to expand the ${ENV_VAR} references in
# `mcp.json` and `models.yml` at runtime.

# Azure DevOps Personal Access Token — used by the "ado" MCP server in mcp.json
# Needed for repo, work-item, and pull-request access.
PERSONAL_ACCESS_TOKEN=

# Z.ai (Zhipu) API key — used by zai-mcp-server, web-reader, web-search-prime, and zread in mcp.json
# Used as the Authorization: Bearer token for those tools.
Z_AI_API_KEY=

# Azure AI Foundry API key — used by the microsoft-foundry provider in models.yml
# Required to call hosted Foundry models.
MICROSOFT_FOUNDRY_API_KEY=

# NVIDIA API key — used by the nvidia-image-gen skill (scripts/generate.py)
# Must start with 'nvapi-'. Get one at https://build.nvidia.com
NVIDIA_API_KEY=

# Optional: enable proxy support for the "ado" MCP server (set to 1 to use environment proxy vars).
NODE_USE_ENV_PROXY=1
