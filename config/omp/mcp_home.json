{
  "description": "HOME variant \u2014 full server set including the Z.ai MCP servers (zai-mcp-server, web-reader, web-search-prime, zread). Companion to the trimmed portable mcp.json at the repo root (work machines). Symlink this to ~/.omp/agent/mcp.json on home machines: ln -sfn \"$HOME/.agents/config/omp/mcp_home.json\" \"$HOME/.omp/agent/mcp.json\"",
  "mcpServers": {
    "ado": {
      "args": [
        "-y",
        "@azure-devops/mcp",
        "JadeSoftware",
        "-a",
        "pat",
        "-d",
        "core",
        "repositories",
        "work-items",
        "pipelines"
      ],
      "command": "npx",
      "environment": {
        "NODE_USE_ENV_PROXY": "1",
        "PERSONAL_ACCESS_TOKEN": "${PERSONAL_ACCESS_TOKEN}"
      },
      "transport": "stdio"
    },
    "context7": {
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ],
      "command": "npx",
      "transport": "stdio"
    },
    "github": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "command": "npx",
      "transport": "stdio"
    },
    "playwright": {
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "command": "npx",
      "transport": "stdio"
    },
    "web-reader": {
      "headers": {
        "Authorization": "Bearer ${Z_AI_API_KEY}"
      },
      "transport": "streamable-http",
      "url": "https://api.z.ai/api/mcp/web_reader/mcp"
    },
    "web-search-prime": {
      "headers": {
        "Authorization": "Bearer ${Z_AI_API_KEY}"
      },
      "transport": "streamable-http",
      "url": "https://api.z.ai/api/mcp/web_search_prime/mcp"
    },
    "zai-mcp-server": {
      "args": [
        "-y",
        "@z_ai/mcp-server"
      ],
      "command": "npx",
      "environment": {
        "Z_AI_API_KEY": "${Z_AI_API_KEY}",
        "Z_AI_MODE": "ZAI"
      },
      "transport": "stdio"
    },
    "zread": {
      "headers": {
        "Authorization": "Bearer ${Z_AI_API_KEY}"
      },
      "transport": "streamable-http",
      "url": "https://api.z.ai/api/mcp/zread/mcp"
    }
  },
  "requiredEnvironment": [
    "PERSONAL_ACCESS_TOKEN",
    "Z_AI_API_KEY"
  ],
  "source": {
    "mcp": "~/.agents/config/opencode/opencode.json (mcp)",
    "notes": "OpenCode 'type: local' command arrays split into command + args (transport stdio); 'type: remote' URLs mapped to transport streamable-http with headers preserved. Environment keys and header names are preserved verbatim so vendor configs can be reconstructed."
  },
  "version": 1
}
