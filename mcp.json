{
  "description": "Portable .agents Protocol MCP server config — mirror of pi's config/pi/mcp.json (the runtime source). Credential literals are replaced with ${ENV_VAR} placeholders; set these variables in the shell environment. pi itself reads config/pi/mcp.json through the ~/.pi/agent symlink; this file exists for protocol portability.",
  "mcpServers": {
    "ado": {
      "args": [
        "-y",
        "@azure-devops/mcp",
        "JadeSoftware",
        "-a",
        "pat",
        "-d",
        "core",
        "repositories",
        "work-items",
        "pipelines"
      ],
      "command": "npx",
      "environment": {
        "NODE_USE_ENV_PROXY": "1",
        "PERSONAL_ACCESS_TOKEN": "${PERSONAL_ACCESS_TOKEN}"
      },
      "transport": "stdio"
    },
    "context7": {
      "args": ["-y", "@upstash/context7-mcp@latest"],
      "command": "npx",
      "transport": "stdio"
    },
    "fusion360": {
      "args": [
        "--with",
        "mcp==1.26.0",
        "fusion360-mcp-server",
        "--mode",
        "socket"
      ],
      "command": "uvx",
      "transport": "stdio"
    },
    "github": {
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "command": "npx",
      "transport": "stdio"
    },
    "godot": {
      "args": ["-y", "@coding-solo/godot-mcp"],
      "command": "npx",
      "environment": {
        "GODOT_PATH": "/Applications/Godot.app/Contents/MacOS/Godot"
      },
      "transport": "stdio"
    },
    "konnect": {
      "command": "/Users/luke/.local/bin/konnect",
      "transport": "stdio"
    },
    "playwright": {
      "args": ["-y", "@playwright/mcp@latest"],
      "command": "npx",
      "transport": "stdio"
    },
    "web-reader": {
      "transport": "streamable-http",
      "url": "https://api.z.ai/api/mcp/web_reader/mcp",
      "headers": {
        "Authorization": "Bearer ${Z_AI_API_KEY}"
      }
    },
    "web-search-prime": {
      "transport": "streamable-http",
      "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
      "headers": {
        "Authorization": "Bearer ${Z_AI_API_KEY}"
      }
    },
    "zai-mcp-server": {
      "args": ["-y", "@z_ai/mcp-server"],
      "command": "npx",
      "environment": {
        "Z_AI_API_KEY": "${Z_AI_API_KEY}",
        "Z_AI_MODE": "ZAI"
      },
      "transport": "stdio"
    },
    "zread": {
      "transport": "streamable-http",
      "url": "https://api.z.ai/api/mcp/zread/mcp",
      "headers": {
        "Authorization": "Bearer ${Z_AI_API_KEY}"
      }
    }
  },
  "requiredEnvironment": ["PERSONAL_ACCESS_TOKEN", "Z_AI_API_KEY"],
  "version": 1
}
